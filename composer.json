{
    "name": "fabio/login-seguro",
    "description": "Login web seguro (Argon2id + Doctrine ORM + SQLite 3)",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.3",
        "symfony/cache": "^7.0",
        "symfony/var-exporter": "^7.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
